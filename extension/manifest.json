{
  "manifest_version": 3,
  "name": "CS2 Meta Engine — HLTV demo import",
  "short_name": "CS2 Meta Engine",
  "version": "1.0.0",
  "description": "Adds a \"Send to CS2 Meta Engine\" button to HLTV match pages. Your browser downloads the demo; the app imports it.",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "https://www.hltv.org/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.hltv.org/matches/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "CS2 Meta Engine — settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
