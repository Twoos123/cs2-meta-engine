# Copy to .env and fill in your values. docker-compose reads this via
# env_file. Never commit the real .env.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Claude API key — powers AI match recaps and lineup descriptions
ANTHROPIC_API_KEY=
# Fallback when ANTHROPIC_API_KEY is unset (free OpenRouter models)
OPENROUTER_API_KEY=
# FACEIT Data API v4 key — enables FACEIT match ingest
FACEIT_API_KEY=
# Required header (X-Admin-Token) for deletes, uploads and CS2 path settings.
# Leave empty on a private machine; set it whenever the app is reachable
# from other devices. The browser prompts for it once and remembers it.
ADMIN_TOKEN=

# ── Directories ──────────────────────────────────────────────────────────────
# Defaults are correct for local dev (repo-relative). Under Docker, compose
# overrides these to container paths — leave them unset there.
#DEMO_DIR=demos
#DB_PATH=data/lineups.db

# ── Docker only ──────────────────────────────────────────────────────────────
# Host port the app is published on (default 80)
#WEB_PORT=80

# ── CS2 RCON (optional — "Practice" teleports into a running CS2 client) ────
# Launch CS2 with -netconport 27015 and set rcon_password in the console.
# From Docker, point RCON_HOST at the LAN machine running CS2.
RCON_HOST=127.0.0.1
RCON_PORT=27015
RCON_PASSWORD=changeme

# ── HLTV scraping ────────────────────────────────────────────────────────────
HLTV_REQUEST_DELAY=2.5    # seconds between requests — be polite

# ── Models ───────────────────────────────────────────────────────────────────
#ANTHROPIC_MODEL=claude-opus-5-5
#OPENROUTER_MODEL=google/gemma-3-27b-it:free

# ── Database + processes ──────────────────────────────────────────────────────
# Postgres (postgresql://user:pass@host:5432/db); empty = SQLite at DB_PATH.
#DATABASE_URL=
# all = API + in-process job worker (local default) · api = enqueue only
# (scaled replicas) · worker = `python -m backend.worker`
#PROCESS_ROLE=all

# ── Liquipedia (match catalog + player photos) ───────────────────────────────
# Goes in the User-Agent per Liquipedia's API terms (a URL or project address).
#LIQUIPEDIA_CONTACT=https://github.com/Twoos123/cs2-meta-engine
